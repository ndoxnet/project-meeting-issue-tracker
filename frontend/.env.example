# Concept by MrHan (08974747477)
# Frontend environment (Vite). NO secrets — this file is safe to commit as an
# example. The access token is NEVER a build-time variable and is never stored.

# API base path. Production default is the relative path (same-origin via Nginx).
VITE_API_BASE_URL=/api/v1

VITE_APP_NAME=Project Meeting Issue Tracker
VITE_APP_VERSION=0.3.0
