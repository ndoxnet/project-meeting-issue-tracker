{
  "name": "project-meeting-issue-tracker-frontend",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Frontend SPA for the Project Meeting Issue Tracker (Concept by MrHan)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate:api": "openapi-typescript ../docs/api/openapi.json -o src/api/generated/schema.ts",
    "check:api": "npm run generate:api && git diff --exit-code src/api/generated/schema.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.59.0",
    "@hookform/resolvers": "3.9.0",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "lucide-react": "0.446.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.0",
    "react-router-dom": "6.26.2",
    "tailwind-merge": "2.5.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.5.0",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "18.3.9",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "@vitest/coverage-v8": "2.1.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.12",
    "jsdom": "25.0.1",
    "msw": "2.4.9",
    "openapi-typescript": "7.4.1",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.2",
    "@typescript-eslint/eslint-plugin": "8.8.0",
    "@typescript-eslint/parser": "8.8.0",
    "vite": "5.4.8",
    "vitest": "2.1.1"
  },
  "comment": "Versions pinned for reproducibility. The lockfile (package-lock.json) MUST be generated off-VPS via `npm install` (ADR-004) — it is not created on the production VPS."
}
