# Concept by MrHan (08974747477)
# Project Meeting Issue Tracker — environment template
# Copy to `.env` and fill real values. NEVER commit the real .env.
# All CHANGE_ME values MUST be replaced before any deployment.

# ---- Application ----
APP_NAME=Project Meeting Issue Tracker
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=false

# ---- Auth / security ----
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- Database (internal Docker network only — never exposed to host) ----
POSTGRES_DB=issue_tracker
POSTGRES_USER=issue_tracker_app
POSTGRES_PASSWORD=CHANGE_ME
# asyncpg driver; host "postgres" is the compose service name
DATABASE_URL=postgresql+asyncpg://issue_tracker_app:CHANGE_ME@postgres:5432/issue_tracker

# ---- Localization ----
DISPLAY_TIMEZONE=Asia/Jakarta

# ---- Business rules ----
STAGNANT_DAYS=7
ISSUE_CODE_PREFIX=ISS

# ---- Attachments ----
ATTACHMENT_MAX_MB=10
ATTACHMENT_ALLOWED_TYPES=application/pdf,image/jpeg,image/png
STORAGE_PATH=/app/storage

# ---- CORS ----
# Comma-separated list of allowed origins for the browser SPA
ALLOWED_ORIGINS=http://127.0.0.1:5200

# ---- Initial admin (used once by seed script; not a runtime credential) ----
ADMIN_EMAIL=CHANGE_ME
ADMIN_USERNAME=CHANGE_ME
ADMIN_INITIAL_PASSWORD=CHANGE_ME

# ---- Frontend host binding (only the frontend binds to the host) ----
FRONTEND_BIND_HOST=127.0.0.1
FRONTEND_BIND_PORT=5200
